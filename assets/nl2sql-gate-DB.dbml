// =====================================================================
// nl2sql-gate 서비스 DB — 최종본 (구현 진행 상황 반영)
// dbdiagram.io 에 붙여넣으면 다이어그램이 그려진다
//
// 각 테이블 Note 맨 앞에 구현 상태를 표시했다.
//   [구현] 코드가 실제로 읽고 쓴다
//   [부분] 일부 컬럼만 채워지거나, 일부만 읽는다
//   [설계만] 테이블은 있지만 코드가 아직 안 건드린다 — 하드코딩된 Demo* 클래스가 대신하고 있음
// =====================================================================

Project nl2sql_gate {
  database_type: 'PostgreSQL'
  Note: '''
    이 다이어그램에는 두 종류의 테이블이 섞여 있다.

    1) 서비스 자체 제어 테이블 (tenant, app_user, glossary_*, query_log, conversation 등)
       — `app` 계정으로 접근. 서비스 로직이 소유한다.
    2) 데모용 "고객사 운영 데이터" (region, dept, emp_public, ord)
       — `llm_reader` 라는 별도의 읽기 전용 계정으로만 접근한다.

    실서비스라면 2)는 고객사가 소유한 별도 DB이고, 이 서비스는 datasource 테이블에
    등록된 접속 정보로 남의 DB에 read-only로 붙어야 한다. 지금은 데모 규모라
    **같은 Postgres 인스턴스 안에 물리적으로 같이 넣어뒀다** — app과 llm_reader
    두 계정을 완전히 분리해서 이 트레이드오프의 위험을 줄인다
    (트레이드오프-app-llm_reader-DB분리.md 참고).

    운영 데이터의 조회 결과(행)는 어떤 서비스 테이블에도 저장하지 않는다.
    저장하면 두 가지가 깨지기 때문이다.
      1) 권한이 강등된 사용자가 예전 결과를 계속 볼 수 있게 된다
      2) 고객사의 개인정보가 이 서비스 DB로 복제된다
    그래서 query_log 에는 질문, 실행된 SQL, 행 수만 남고 결과 표는 남지 않는다.
  '''
}

// ---------------------------------------------------------------- enum

Enum user_role {
  STAFF   [note: 'level 10']
  MANAGER [note: 'level 50']
  ADMIN   [note: 'level 100']
}

Enum column_kind {
  NUMBER
  MONEY
  PERCENT
  DATE
  TEXT
  ID      [note: '숫자여도 측정값이 아님. 그래프 축 후보에서 제외']
}

Enum query_status {
  SUCCESS
  CLARIFY [note: '기준이 애매해 되물음']
  DENIED  [note: '권한 밖의 데이터']
  BLOCKED [note: '읽기 외 요청이라 생성 단계에서 중단']
  ERROR   [note: '2회 재생성 후에도 검증 실패']
}

Enum deny_reason {
  TABLE_NOT_ALLOWED
  COLUMN_NOT_ALLOWED
  WRITE_ATTEMPT
  UNPARSEABLE
  MULTI_STATEMENT
}

// ------------------------------------------------------------- 회사·사용자

Table tenant {
  id            uuid       [pk, default: `gen_random_uuid()`]
  code          varchar(32) [not null, unique, note: '로그인 시 입력하는 회사 코드']
  name          varchar(120) [not null]
  active        boolean    [not null, default: true]
  created_at    timestamptz [not null, default: `now()`]

  Note: '''
    [구현] `DefaultTenantProvisioner`가 부팅 시 row가 없으면 하나 자동 생성, 있으면 재사용한다.

    설계 포인트 — 모든 테이블에 tenant_id를 처음부터 넣어뒀지만 실제 운영은 싱글테넌트다.
    "멀티테넌트 지원"과 "지금 당장 필요한 복잡도"를 분리한 것 — 스키마는 나중을 대비하고,
    로직은 지금 필요한 만큼만 짠다(부록 "멀티테넌트 운영" 항목: "tenant_id 자리만 확보하고
    실제로는 단일 테넌트로 동작시킨다").

    다만 이 분리가 완벽하진 않다 — 아래 app_user의 이메일 유니크 체크가 그 증거다.
  '''
}

Table tenant_setting {
  tenant_id     uuid       [pk, ref: - tenant.id]
  fiscal_year_start_month  int     [not null, default: 1, note: "'작년'의 기준"]
  revenue_includes_cancelled boolean [not null, default: false]
  default_recent_days      int     [not null, default: 30, note: "'최근'의 기준"]
  extra         jsonb      [note: '추가 기본값']
  updated_at    timestamptz [not null, default: `now()`]

  Note: '''
    [설계만] 테이블만 있고 읽는 코드가 없다.

    지금 "작년"의 정의(역년 기준)는 이 테이블이 아니라 glossary_term에 텍스트로
    등록돼 있다 — 회사마다 다른 회계연도 시작월 같은 "숫자 하나로 결정되는 설정"과
    "말로 설명해야 하는 업무 용어"가 지금은 같은 테이블(glossary_term)에 뭉쳐 있는 셈이다.
    회사가 늘어나면 이 둘을 분리해서 fiscal_year_start_month처럼 구조화된 값은
    여기로, 서술적인 정의는 glossary_term에 남기는 정리가 필요해진다.
  '''
}

Table app_user {
  id            uuid       [pk, default: `gen_random_uuid()`]
  tenant_id     uuid       [not null, ref: > tenant.id]
  email         varchar(200) [not null]
  name          varchar(80) [not null]
  role          user_role  [not null, default: 'STAFF']
  role_level    int        [not null, default: 10, note: '비교용 숫자 등급']
  password_hash varchar(255) [not null]
  active        boolean    [not null, default: false]
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, email) [unique]
  }

  Note: '''
    [구현] `AppUserRepository` — 로그인/회원가입/역할 조회 전부 이 테이블.

    설계 포인트 1 — role(enum) + role_level(int) 이중 저장.
    role은 사람이 읽는 이름, role_level은 비교 연산(>=)에 쓰는 숫자다.
    "STAFF(10) < MANAGER(50) < ADMIN(100)" 판정 로직이 role 이름을 몰라도 되고,
    나중에 역할이 4개, 5개로 늘어나도 `role.level() >= threshold` 비교 코드는 안 바뀐다.

    설계 포인트 2(발견한 기술부채) — UNIQUE(tenant_id, email)는 "이메일이 테넌트
    안에서만 유니크"를 의도한 건데, 실제 `AppUserRepository.findByEmail`/
    `existsByEmail`는 tenant_id 없이 이메일 하나로만 전역 조회한다. 지금은
    테넌트가 하나뿐이라 문제가 안 보이지만, 두 번째 회사가 생기는 순간 실제
    코드가 스키마의 멀티테넌트 의도를 못 따라가는 지점이 된다.
  '''
}

// -------------------------------------------------- 운영 DB 접속 + 스키마 메타

Table datasource {
  id            uuid       [pk, default: `gen_random_uuid()`]
  tenant_id     uuid       [not null, ref: > tenant.id]
  name          varchar(120) [not null]
  jdbc_url      varchar(500) [not null]
  username      varchar(120) [not null]
  secret_ref    varchar(200) [not null, note: '비밀 저장소 참조 키. 비밀번호 평문은 여기 없다']
  read_only_verified boolean [not null, default: false, note: '등록 시 쓰기 시도가 거부되는지 확인한 결과']
  last_introspected_at timestamptz
  created_at    timestamptz [not null, default: `now()`]

  Note: '''
    [설계만] 코드에서 전혀 참조하지 않는다.

    지금은 이 테이블이 가리켜야 할 "고객사 운영 DB"가 존재하지 않고, 데모 데이터가
    이 서비스와 같은 Postgres 안에 있다. 그래서 접속 정보를 등록할 필요 자체가 없다.
    실제 고객사를 온보딩하는 순간 제일 먼저 채워져야 할 테이블이다.
  '''
}

Table schema_table {
  id            uuid       [pk, default: `gen_random_uuid()`]
  datasource_id uuid       [not null, ref: > datasource.id]
  table_name    varchar(120) [not null, note: '운영 DB의 실제 이름 (예: emp_salary)']
  display_name  varchar(120) [note: '직원에게 보이는 이름 (예: 급여)']
  description   text       [note: '프롬프트에 함께 넣는 설명']
  exposed       boolean    [not null, default: false, note: '기본은 비공개. 고른 것만 연다']
  min_role_level int       [not null, default: 10]
  row_estimate  bigint     [note: '대략 행 수. LIMIT 전략 판단에 쓴다']
  updated_at    timestamptz [not null, default: `now()`]

  Indexes {
    (datasource_id, table_name) [unique]
  }

  Note: '''
    [설계만] `DemoRolePolicy.java`(Java 하드코딩 클래스)가 지금 이 테이블의 역할을
    통째로 대신하고 있다 — 허용 테이블 목록(TABLES), role별 허용 컬럼(BASE_COLUMNS /
    MANAGER_ONLY_COLUMNS)이 전부 코드에 상수로 박혀 있다.

    임시로 `GET /api/admin/tables`(SchemaCatalogController)를 만들어 이 하드코딩을
    그대로 읽어 응답하게 해뒀다 — 나중에 이 테이블이 실제로 쓰이기 시작하면
    컨트롤러 내부 구현만 SQL 조회로 갈아끼우면 되도록, 응답 모양(SchemaCatalogTable)은
    이 테이블의 컬럼 구조를 미리 흉내내서 설계했다.
  '''
}

Table schema_column {
  id              uuid     [pk, default: `gen_random_uuid()`]
  schema_table_id uuid     [not null, ref: > schema_table.id]
  column_name     varchar(120) [not null]
  display_name    varchar(120)
  data_type       varchar(60) [not null, note: 'JDBC 타입']
  kind            column_kind [not null, default: 'TEXT']
  exposed         boolean  [not null, default: false]
  pii             boolean  [not null, default: false, note: 'true면 공개 전환 시 확인을 받는다']
  min_role_level  int      [not null, default: 10]
  description     text
  ordinal         int      [not null]

  Indexes {
    (schema_table_id, column_name) [unique]
  }

  Note: '''
    [설계만] `DemoRolePolicy.MANAGER_ONLY_COLUMNS`(emp_public.salary, emp_public.rrn)가
    이 테이블의 min_role_level 역할을 대신한다.

    설계 포인트 — pii 플래그는 "공개 전환 시 확인을 받는다"는 안전장치인데, 지금
    하드코딩 버전엔 이런 2단계 확인 절차가 없다. 이 테이블이 실제로 붙으면
    단순 boolean 하나가 아니라 운영 프로세스(확인 절차)까지 같이 들어와야 하는
    컬럼이라는 뜻 — 스키마가 코드보다 앞서 설계된 좋은 예다.
  '''
}

Table schema_relation {
  id            uuid       [pk, default: `gen_random_uuid()`]
  datasource_id uuid       [not null, ref: > datasource.id]
  from_table_id uuid       [not null, ref: > schema_table.id]
  from_column   varchar(120) [not null]
  to_table_id   uuid       [not null, ref: > schema_table.id]
  to_column     varchar(120) [not null]
  source        varchar(20) [not null, default: 'FK', note: 'FK 자동 수집 또는 MANUAL 수동 입력']

  Note: '''
    [설계만] `DemoSchemaRelationships.FOREIGN_KEYS`(Java Map)가 지금 이 테이블 역할.

    설계 히스토리 — 처음엔 "이 조합은 JOIN하면 안 된다"는 경고를 자연어 문장으로
    프롬프트에 박아뒀다가, LLM이 그 경고 문장을 엉뚱한 질문에도 그대로 복붙하는
    회귀를 겪었다(프롬프트-회귀-분석.md). 그래서 "안 되는 것"을 경고하는 대신
    "되는 것"만 `emp_public.dept_id → dept.id` 식으로 명시적으로 선언하고 나머지는
    아예 언급하지 않는 방식으로 바꿨다 — 정확히 이 테이블(from/to 쌍의 명시적
    나열)이 하려는 일과 같은 방향이다. 이 테이블이 붙으면 하드코딩 Map을
    걷어내고 여기서 읽으면 된다.
  '''
}

// ---------------------------------------------------------------- 용어사전

Table glossary_term {
  id            uuid       [pk, default: `gen_random_uuid()`]
  tenant_id     uuid       [not null, ref: > tenant.id]
  term          varchar(80) [not null]
  definition    text       [not null]
  sql_hint      text       [note: '계산 기준. 검증 없이 그대로 실행하지는 않는다']
  related_tables text[]    [note: '관련 테이블 이름 배열']
  min_role_level int       [not null, default: 10]
  enabled       boolean    [not null, default: true]
  embedding     vector(1536) [note: 'pgvector. 항목이 100개를 넘어 검색으로 전환할 때만 채운다']
  created_by    uuid       [ref: > app_user.id]
  updated_at    timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, term) [unique]
    embedding
  }

  Note: '''
    [구현] `GlossaryRepository` + `GlossaryController` — CRUD 전부 실제로 이 테이블을 쓴다.
    36개 데모 용어(매출/인사 도메인)를 이 테이블에 시드해뒀다.

    설계 포인트 1 — min_role_level은 "조회 권한"과 다른 축이다. 컬럼 접근 권한
    (schema_column.min_role_level, 지금은 DemoRolePolicy)과 별개로, "이 용어를
    프롬프트에 넣어도 되는가"를 따로 관리한다. 실제로 겪은 사례: "평균 연봉"
    용어의 min_role_level을 10(STAFF)으로 두면, salary 컬럼 자체는 못 보는
    STAFF에게 "이런 지표가 있다"는 정의만 프롬프트에 노출되고 계산은 실패한다.
    그래서 salary가 들어간 용어는 전부 50(MANAGER)으로 맞췄다 — "권한 밖 데이터는
    존재 자체를 모르게 한다"(기획서 8.1)는 원칙을 용어사전 레벨까지 관통시킨 것.

    설계 포인트 2 — sql_hint는 LLM에게 주는 "힌트"일 뿐 신뢰하고 그대로 실행하는
    값이 아니다. `GlossaryRepository.promptTerms()`가 definition과 합쳐서 텍스트로
    주입하고, 최종적으로 만들어진 SQL은 여전히 SqlGate(AST 파싱)가 독립적으로
    검증한다 — 용어사전이 검증 계층을 우회하는 지름길이 되지 않도록 막은 것
    (기획서 8장 "3층 방어" 중 프롬프트 층과 검증 층의 역할 분리).

    설계 포인트 3 — embedding(pgvector)은 이미 확장까지 설치돼 있지만 지금은
    아무 row도 값이 없다. 10테이블·36용어 규모에선 전체를 프롬프트에 다 넣어도
    충분해서다(부록: "테이블 50개 초과 시 필요"). 규모가 커지면 이 컬럼을 채우고
    유사도 검색으로 전환할 자리를 미리 파둔 것.

    UNIQUE(tenant_id, term) 제약은 실제로 애플리케이션 예외 처리와 연결돼 있다 —
    중복 등록 시 Postgres가 던지는 제약 위반을 Spring의 `DuplicateKeyException`으로
    받아 `GlossaryExceptionHandler`가 409로 변환한다.
  '''
}

Table glossary_alias {
  id            uuid       [pk, default: `gen_random_uuid()`]
  term_id       uuid       [not null, ref: > glossary_term.id]
  alias         varchar(80) [not null]

  Indexes {
    (term_id, alias) [unique]
    alias
  }

  Note: '''
    [구현] `GlossaryRepository`가 용어 등록/수정 시 기존 alias를 전부 지우고
    새로 받은 목록으로 다시 넣는 "전체 교체" 방식으로 관리한다(부분 diff 없음) —
    목록이 작을 땐 개별 추가/삭제보다 구현이 훨씬 단순하고 버그 여지가 적다.
  '''
}

// ------------------------------------------------------------ 대화와 기록

Table conversation {
  id            uuid       [pk, default: `gen_random_uuid()`]
  tenant_id     uuid       [not null, ref: > tenant.id]
  user_id       uuid       [not null, ref: > app_user.id]
  title         varchar(200) [note: '첫 질문에서 자동 생성']
  deleted_at    timestamptz [note: '사용자 화면에서만 사라진다. query_log 는 남는다']
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, updated_at)
  }

  Note: '''
    [설계만] 코드가 전혀 안 읽고 안 쓴다 — 지금 프론트의 질문 히스토리(Pinia
    `useAskStore.history`)는 브라우저 메모리에만 있어서 새로고침하면 사라진다.

    이 테이블이 실제로 붙으면 그 문제가 풀린다: 질문마다 conversation_id를
    query_log에 채우고, 로그인 시 `GET /conversations`로 다시 불러오면 된다.
    deleted_at을 soft delete로 둔 이유도 이미 여기 있다 — "사용자가 화면에서
    지워도 감사 기록(query_log)은 남아야 한다"는 원칙을 이 테이블 하나가 대변한다.
  '''
}

Table query_log {
  id            uuid       [pk, default: `gen_random_uuid()`]
  tenant_id     uuid       [not null, ref: > tenant.id]
  conversation_id uuid     [ref: > conversation.id]
  user_id       uuid       [not null, ref: > app_user.id]
  parent_query_id uuid     [ref: > query_log.id, note: '이어 묻기']

  question      text       [not null]
  status        query_status [not null]

  generated_sql text       [note: '모델이 만든 초안']
  executed_sql  text       [note: '검증을 통과해 실제로 실행된 것']
  denied_reason deny_reason [note: 'status 가 DENIED / BLOCKED 일 때']
  denied_detail varchar(200) [note: '어느 테이블·컬럼에서 걸렸는지']

  clarify_options jsonb    [note: '되물음 선택지']
  clarify_choice  varchar(60) [note: '사용자가 고른 값']

  applied_term_ids uuid[]  [note: '이번 조회에 적용된 용어']

  row_count     int
  truncated     boolean    [not null, default: false]
  latency_ms    int
  retry_count   int        [not null, default: 0, note: '검증 실패로 재생성한 횟수']
  model         varchar(60)
  user_role_at_time user_role [not null, note: '당시 권한. 나중에 역할이 바뀌어도 기록은 그대로여야 한다']
  is_test       boolean    [not null, default: false, note: '용어 관리 화면의 시험 질문']

  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, created_at)
    (user_id, created_at)
    (tenant_id, status)
    parent_query_id
  }

  Note: '''
    [부분구현] 이 프로젝트에서 가장 많이 실제로 두들겨본 테이블.
    `QueryOrchestrator.audit()`가 매 요청마다 INSERT하고, `GET /api/admin/query-logs`
    (keyset pagination) / `GET /api/admin/stats`(월 단위 집계)가 실제로 읽는다.

    지금 채워지는 컬럼: id, tenant_id, user_id, question, status, generated_sql,
    executed_sql, denied_detail, row_count, truncated, retry_count, model,
    user_role_at_time, latency_ms.
    아직 안 채워지는 컬럼: conversation_id(대화 기능 없음), parent_query_id
    (이어묻기 없음), denied_reason(FailureType이라는 별도 Java enum만 있고
    이 DB enum과 매핑 안 함), clarify_options/clarify_choice(지금 CLARIFY는
    선택지 없이 문장 하나뿐), applied_term_ids(용어사전 적용 추적 없음 —
    그래서 `/api/admin/stats`의 topTerms는 항상 빈 배열), is_test.

    latency_ms는 스키마엔 처음부터 있었는데, 실제로 채우기 시작한 건 사용현황
    기능을 만들 때였다 — `handle()` 진입 시각(`System.nanoTime()`)을 오케스트레이터
    끝까지 들고 다니다가 감사 로그를 남기는 순간 밀리초로 환산한다. 스키마가
    코드보다 먼저 완성돼 있었고, 그 컬럼을 실제로 쓰는 건 몇 단계 뒤였다는
    좋은 예다.

    인덱스 3종((tenant_id, created_at) 등)은 지금 실제 쿼리 패턴과 정확히 맞물린다 —
    query-logs는 tenant_id로 좁힌 뒤 created_at DESC로 페이지네이션하고, stats는
    tenant_id + created_at 범위로 집계한다. 다만 실제 DB(`nl2sql-gate-db.sql`)엔
    아직 이 인덱스들이 CREATE INDEX로 만들어지지 않았다 — 지금 데이터량(수십~수백
    행)에서는 안 보이지만, 감사 로그 특성상 가장 빨리 쌓이는 테이블이라 실사용
    단계에서 제일 먼저 인덱스를 만들어야 할 후보 1순위다.

    결과 행은 저장하지 않는다는 원칙(기획서 3장)이 이 테이블 설계의 핵심이다 —
    지난 질문을 다시 볼 때 저장된 표를 꺼내는 게 아니라 executed_sql을 그
    시점의 권한으로 다시 검사해 재실행하는 구조를 전제로 한다.
  '''
}

// -------------------------------------------- 데모용 고객사 업무 데이터 (llm_reader 전용)

Table region {
  id      integer   [pk, increment]
  name    varchar(40) [not null]

  Note: '[구현] 지역 5개 시드(서울/경기/인천/부산/대구). ord.region_id가 참조한다.'
}

Table dept {
  id      integer   [pk, increment]
  name    varchar(40) [not null]

  Note: '[구현] 부서 5개 시드. emp_public.dept_id가 참조한다.'
}

Table emp_public {
  id        integer   [pk, increment]
  dept_id   integer   [not null, ref: > dept.id]
  name      varchar(60) [not null]
  hired_at  date      [not null]
  salary    int       [not null, note: '단위: 만원. MANAGER 이상만 조회 가능(DemoRolePolicy)']
  rrn       varchar(20) [not null, note: '주민등록번호. MANAGER 이상만 조회 가능 — STAFF에겐 컬럼 존재 자체가 안 보임']

  Note: '''
    [구현] 직원 30명 시드(부서당 6명, 부서별 급여 수준 다르게 생성 —
    "부서별 평균 연봉" 질문이 의미 있는 결과를 내도록 의도적으로 분산시켰다).

    설계 포인트 — salary/rrn을 role별로 프롬프트에서 아예 빼버리는 방식
    (DemoRolePolicy.MANAGER_ONLY_COLUMNS)은 기획서 8.1의 핵심 아이디어를
    코드로 그대로 옮긴 것: "금지된 컬럼은 LLM이 존재 자체를 모른다." STAFF로
    "부서별 평균 연봉은?"을 물으면 DENIED가 아니라 CLARIFY로 돌아오는 걸
    실제로 확인했다 — 컬럼이 프롬프트에 없으니 모델이 "그런 컬럼이 있는지
    확인해달라"고 되묻는 것이지, "권한이 없다"고 판단하는 게 아니다.
  '''
}

Table ord {
  id         integer  [pk, increment]
  region_id  integer  [not null, ref: > region.id]
  amt        int      [not null, note: '주문 금액']
  ord_dt     date     [not null]

  Note: '''
    [구현] 주문 데이터. 최초 2,000건은 2025년 한 해로 고정 생성됐고("이번달"/
    "최근 30일" 질문이 실제 오늘 날짜와 안 맞아 늘 0건이 되는 문제가 있었다),
    이후 CURRENT_DATE 기준 최근 365일로 채우는 2,000건을 추가해 언제 실행해도
    "이번달"류 질문이 실제 데이터를 만나도록 보강했다(nl2sql-gate-seed-extra-orders.sql).

    설계 포인트 — 지역별 물량 가중치(서울 40% ~ 대구 8%)와 11~12월 성수기
    가중치(1.4배)를 줘서 완전 랜덤이 아니라 "지역별 매출", "월별 매출" 질문이
    실제로 편차 있는 결과를 내도록 의도적으로 분포를 설계했다 — 데모 데이터도
    무작위가 아니라 보여주려는 기능에 맞춰 설계한다는 것을 보여주는 지점.

    emp_public/dept 그룹과는 어떤 컬럼으로도 연결되지 않는다 — 이 "연결 없음"
    자체가 DemoSchemaRelationships의 핵심 설계 포인트(위 schema_relation 참고):
    LLM이 이름이 비슷한 컬럼(예: emp_public.id, ord.id)을 억지로 엮어 틀린
    숫자를 SUCCESS로 반환하는 걸 실제로 겪은 뒤, "존재하는 관계만 선언하고
    나머지는 언급조차 안 한다"는 원칙으로 막았다.
  '''
}
