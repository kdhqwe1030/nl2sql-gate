# docker-compose가 루트 .env에서 읽어가는 값들.
# 이 파일을 복사해서 .env로 만들고 실제 값을 채운다 (.env는 .gitignore에 이미 걸려있음).
#   cp .env.example .env

# OpenAI API 키 (SQL 생성용)
OPENAI_API_KEY=

# JWT 서명 키 — 아무 문자열이나 되지만, 예를 들면:
#   openssl rand -base64 32
JWT_SECRET_KEY=

# llm_reader(read-only) DB 계정 비밀번호.
# db 컨테이너 초기화 스크립트(db/init/02-create-llm-reader-role.sh)와
# backend의 EXECUTION_DATASOURCE_PASSWORD가 이 값을 공유해서 쓴다 — 하나만 바꾸면 둘 다 반영됨.
LLM_READER_DB_PASSWORD=
